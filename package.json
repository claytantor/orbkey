{
  "name": "orbkey",
  "version": "0.1.0",
  "description": "AWS-backed, local-first secrets vault — TypeScript/Ink rewrite",
  "license": "MIT",
  "author": "claytantor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claytantor/orbkey-ts.git"
  },
  "type": "module",
  "bin": {
    "orbkey": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^11.8.0",
    "clipboardy": "^4.0.0",
    "fast-xml-parser": "^4.5.1",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "aws-sdk-client-mock": "^4.1.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
